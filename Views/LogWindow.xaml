<Window x:Class="WoodStreamFileSync.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WoodStreamFileSync.Views"
        xmlns:viewmodels="clr-namespace:WoodStreamFileSync.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:LogViewModel}"
        Title="{DynamicResource Logs.Title}"
        Height="550" Width="850"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Text.Primary}"
        FontFamily="Segoe UI, Meiryo UI, sans-serif"
        FontSize="12"
        Icon="/Resources/app_icon.ico">

    <Window.Resources>
        <views:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Button.SecondaryBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Button.SecondaryForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Button.SecondaryBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Button.SecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Theme.Header.Background}" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource Logs.Header}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.Header.Text}"/>
                </StackPanel>
                <CheckBox Content="{DynamicResource Logs.AutoScroll}" IsChecked="{Binding AutoScroll}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Foreground="{DynamicResource Theme.Header.SubText}"/>
            </Grid>
        </Border>

        <!-- Log List -->
        <ListView x:Name="LogListView" Grid.Row="1" ItemsSource="{Binding Logs}"
                  Background="{DynamicResource Theme.Log.Background}"
                  Foreground="{DynamicResource Theme.Log.Foreground}"
                  FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="11" Margin="8" BorderThickness="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.Log.SelectedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.Log.SelectedBackground}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp}" Foreground="#94A3B8"/>
                        <Border Grid.Column="1" HorizontalAlignment="Left" CornerRadius="3" Padding="4,1" Margin="0,0,4,0"
                                Background="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}">
                            <TextBlock Text="{Binding Level}" Foreground="White" FontWeight="Bold" FontSize="9"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="#60A5FA" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{DynamicResource Theme.Log.Foreground}" TextWrapping="Wrap"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Bottom Actions -->
        <Border Grid.Row="2" Background="{DynamicResource Theme.BottomBar.Background}"
                BorderBrush="{DynamicResource Theme.Border.Separator}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{DynamicResource Logs.BtnCopy}" Command="{Binding CopyLogsCommand}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="{DynamicResource Logs.BtnClear}" Command="{Binding ClearLogsCommand}" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="{DynamicResource Logs.BtnOpenFolder}" Command="{Binding OpenLogFolderCommand}"/>

                <Button Grid.Column="4" Content="{DynamicResource Logs.BtnClose}" Click="OnCloseClicked"/>
            </Grid>
        </Border>
    </Grid>
</Window>
