<Window x:Class="WoodStreamFileSync.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WoodStreamFileSync.Views"
        xmlns:viewmodels="clr-namespace:WoodStreamFileSync.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
        Title="{DynamicResource Settings.Title}"
        Height="820" Width="850"
        MinHeight="620" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Text.Primary}"
        FontFamily="Segoe UI, Meiryo UI, sans-serif"
        FontSize="13"
        Icon="/Resources/app_icon.ico">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <views:SyncStatusToBrushConverter x:Key="SyncStatusToBrushConverter"/>
        <views:AppThemeToStringConverter x:Key="AppThemeToStringConverter"/>
        <views:AppLanguageToStringConverter x:Key="AppLanguageToStringConverter"/>

        <!-- Modern Dynamic Control Styles -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Card.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Card.Background}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Margin="{TemplateBinding Margin}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                                  Color="{DynamicResource Theme.Card.ShadowColor}" Opacity="0.15"/>
                            </Border.Effect>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.Row="0" ContentSource="Header" RecognizesAccessKey="True" Margin="0,0,0,12"/>
                                <ContentPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Input.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Input.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Input.Foreground}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Input.Foreground}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Input.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Input.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Input.Foreground}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Input.Foreground}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Theme.Button.SecondaryBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Button.SecondaryForeground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Button.SecondaryBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Button.SecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable Content -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Theme.Header.Background}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="/Resources/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{DynamicResource App.Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Header.Text}"/>
                            <TextBlock Text=" v1.0.0.0" FontSize="11" Foreground="{DynamicResource Theme.Header.SubText}" Margin="6,0,0,2" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource App.Subtitle}" FontSize="11" Foreground="{DynamicResource Theme.Header.SubText}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" Background="{DynamicResource Theme.StatusBadge.Background}" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                 Fill="{Binding CurrentSyncStatus, Converter={StaticResource SyncStatusToBrushConverter}}"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Theme.StatusBadge.Text}" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- 1. 複数同期フォルダ設定 -->
                <GroupBox Header="{DynamicResource Settings.FoldersGroup}">
                    <StackPanel>
                        <!-- リストヘッダー & アクションボタン -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Settings.FolderPairsList}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            <Button Content="{DynamicResource Settings.AddPair}" Command="{Binding AddFolderPairCommand}"
                                    HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,2"/>
                        </Grid>

                        <!-- フォルダペア一覧リスト -->
                        <Border BorderBrush="{DynamicResource Theme.Input.Border}" BorderThickness="1" CornerRadius="6"
                                Background="{DynamicResource Theme.Input.Background}" Margin="0,0,0,12" MaxHeight="180">
                            <ListBox ItemsSource="{Binding FolderPairs}" SelectedItem="{Binding SelectedFolderPair}"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="Margin" Value="2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Button.SecondaryHover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1A2563EB"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2563EB"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                                <TextBlock TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,2,0,0">
                                                    <Run Text="{Binding SourcePath, FallbackValue='(同期元未設定)'}"/>
                                                    <Run Text=" ➔ "/>
                                                    <Run Text="{Binding DestinationPath, FallbackValue='(同期先未設定)'}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="{DynamicResource Settings.PairSyncNow}"
                                                    Command="{Binding DataContext.SyncSinglePairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    FontSize="11" Height="26" Padding="8,0" Margin="8,0,4,0"/>

                                            <Button Grid.Column="3" Content="{DynamicResource Settings.DeletePair}"
                                                    Command="{Binding DataContext.RemoveFolderPairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Foreground="#DC2626"
                                                    FontSize="11" Height="26" Padding="8,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- 選択中ペアの詳細編集エリア -->
                        <Border BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1" CornerRadius="6"
                                Background="{DynamicResource Theme.Window.Background}" Padding="12"
                                Visibility="{Binding SelectedFolderPair, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel DataContext="{Binding SelectedFolderPair}">
                                <!-- ペア名 & 有効化 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.PairName}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,12,0"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" Content="{DynamicResource Settings.PairEnabled}" VerticalAlignment="Center" FontWeight="Medium"/>
                                </Grid>

                                <!-- Source -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.SourcePath}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                    <TextBox Grid.Column="1" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Height="30"/>
                                    <Button Grid.Column="2" Content="{DynamicResource Settings.Browse}" Command="{Binding BrowseSourceCommand}" Style="{StaticResource SecondaryButton}" Height="30"/>
                                </Grid>

                                <!-- Destination -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.DestinationPath}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                    <TextBox Grid.Column="1" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Height="30"
                                             ToolTip="Local path or UNC path (\\server\share\path)"/>
                                    <Button Grid.Column="2" Content="{DynamicResource Settings.Browse}" Command="{Binding BrowseDestinationCommand}" Style="{StaticResource SecondaryButton}" Height="30"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 未選択時のメッセージ -->
                        <TextBlock Text="{DynamicResource Settings.NoFolderSelected}"
                                   Visibility="{Binding SelectedFolderPair, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Foreground="{DynamicResource Theme.Text.Muted}" FontStyle="Italic" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 2. 同期トリガー & 動作モード -->
                <GroupBox Header="{DynamicResource Settings.SyncModeGroup}">
                    <StackPanel>
                        <!-- 定期同期 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding EnablePeriodicSync}" Content="{DynamicResource Settings.EnablePeriodic}" VerticalAlignment="Center" FontWeight="Medium"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0"
                                        IsEnabled="{Binding EnablePeriodicSync}">
                                <TextBlock Text="{DynamicResource Settings.IntervalLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                <ComboBox ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding PeriodicIntervalMinutes}" Width="70" Height="28"/>
                                <TextBlock Text="{DynamicResource Settings.IntervalUnit}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            </StackPanel>
                        </Grid>

                        <!-- リアルタイム検知 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding EnableRealtimeSync}" Content="{DynamicResource Settings.EnableRealtime}" VerticalAlignment="Center" FontWeight="Medium"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0"
                                        IsEnabled="{Binding EnableRealtimeSync}">
                                <TextBlock Text="{DynamicResource Settings.DebounceLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                <TextBox Text="{Binding DebounceDelaySeconds, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="28" TextAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Settings.DebounceUnit}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource Settings.DebounceNote}"
                                   FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" Margin="24,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- 3. NAS認証設定 -->
                <GroupBox Header="{DynamicResource Settings.NasGroup}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding EnableNasAuth}" Content="{DynamicResource Settings.EnableNas}" FontWeight="Medium" Margin="0,0,0,12"/>

                        <Grid IsEnabled="{Binding EnableNasAuth}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings.Username}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NasUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4" Height="32"
                                     ToolTip="e.g. admin or DOMAIN\username"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings.Password}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,4,0,0"/>
                            <PasswordBox Grid.Row="1" Grid.Column="1" Margin="0,8,8,0" Height="32"
                                         views:PasswordBoxHelper.BindPassword="True"
                                         views:PasswordBoxHelper.BoundPassword="{Binding NasPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- 接続テストボタン -->
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Content="{DynamicResource Settings.TestConnection}"
                                    Command="{Binding TestNasConnectionCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="40" VerticalAlignment="Center" Margin="0,4,0,0"/>

                            <!-- 接続テスト結果 -->
                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="10" CornerRadius="6"
                                    Background="{DynamicResource Theme.Input.Background}"
                                    BorderBrush="{DynamicResource Theme.Input.Border}" BorderThickness="1"
                                    Visibility="{Binding ConnectionTestResult, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding ConnectionTestResult}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{Binding IsConnectionTestSuccess, Converter={StaticResource SyncStatusToBrushConverter}}"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 4. Robocopy 詳細オプション -->
                <GroupBox Header="{DynamicResource Settings.RobocopyGroup}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding IsMirror}" Content="{DynamicResource Settings.Mirror}" Margin="0,0,20,8" FontWeight="Medium"/>
                            <CheckBox IsChecked="{Binding IncludeEmptySubdirectories}" Content="{DynamicResource Settings.IncludeEmptySubdirs}" Margin="0,0,20,8"
                                      IsEnabled="{Binding IsMirror, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </WrapPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings.RetryCount}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            <TextBox Grid.Column="1" Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="28" TextAlignment="Center" Margin="8,0,0,0"/>

                            <TextBlock Grid.Column="3" Text="{DynamicResource Settings.WaitTime}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            <TextBox Grid.Column="4" Text="{Binding WaitTimeSeconds, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="28" TextAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings.ExcludeFiles}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            <TextBox Grid.Column="1" Text="{Binding ExcludeFiles, UpdateSourceTrigger=PropertyChanged}" Height="28"
                                     ToolTip="e.g. *.tmp ~* desktop.ini thumbs.db"/>
                        </Grid>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings.ExcludeDirs}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            <TextBox Grid.Column="1" Text="{Binding ExcludeDirs, UpdateSourceTrigger=PropertyChanged}" Height="28"
                                     ToolTip="e.g. $RECYCLE.BIN .git node_modules"/>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings.AdditionalArgs}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            <TextBox Grid.Column="1" Text="{Binding AdditionalArguments, UpdateSourceTrigger=PropertyChanged}" Height="28"
                                     ToolTip="e.g. /FFT /XO /MT:8"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 5. テーマ & 言語 & アプリケーション設定 -->
                <GroupBox Header="{DynamicResource Settings.AppGroup}">
                    <StackPanel>
                        <!-- テーマ選択 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings.ThemeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding ThemeMode}" Width="240" Height="28">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource AppThemeToStringConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- 言語選択 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings.LanguageLabel}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding LanguageMode}" Width="240" Height="28">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource AppLanguageToStringConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <CheckBox IsChecked="{Binding LaunchAtStartup}" Content="{DynamicResource Settings.LaunchStartup}" Margin="0,0,0,8"/>
                        <CheckBox IsChecked="{Binding MinimizeToTrayOnClose}" Content="{DynamicResource Settings.MinimizeOnClose}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <CheckBox IsChecked="{Binding ShowNotificationOnError}" Content="{DynamicResource Settings.NotifyError}" Margin="0,0,20,0"/>
                            <CheckBox IsChecked="{Binding ShowNotificationOnSuccess}" Content="{DynamicResource Settings.NotifySuccess}"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{DynamicResource Theme.BottomBar.Background}"
                BorderBrush="{DynamicResource Theme.Border.Separator}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{DynamicResource Settings.BtnLogs}" Click="OnOpenLogClicked" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="{DynamicResource Settings.BtnHelp}" Click="OnOpenHelpClicked" Style="{StaticResource SecondaryButton}"/>

                <Button Grid.Column="3" Content="{DynamicResource Settings.BtnSyncNow}" Command="{Binding SyncNowCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="{DynamicResource Settings.BtnSave}" Command="{Binding SaveSettingsCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,0"/>
                <Button Grid.Column="5" Content="{DynamicResource Settings.BtnClose}" Click="OnCloseClicked" Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
