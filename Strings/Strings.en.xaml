    <sys:String x:Key="Disclaimer.Subtitle">Please carefully read and agree to the following notices and disclaimer before using this software.</sys:String>
    <sys:String x:Key="Disclaimer.Checkbox">I have read, understood, and agree to the terms and disclaimer above</sys:String>
    <sys:String x:Key="Disclaimer.BtnAccept">Accept &amp; Start</sys:String>
    <sys:String x:Key="Disclaimer.BtnDecline">Decline &amp; Exit</sys:String>

    <sys:String x:Key="Help.BtnClose">Close</sys:String>

</ResourceDictionary>
