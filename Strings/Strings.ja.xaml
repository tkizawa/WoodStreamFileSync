<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- App Common -->
    <sys:String x:Key="App.Title">WoodStreamFileSync</sys:String>
    <sys:String x:Key="App.Subtitle">Robocopy &amp; NAS 自動同期バックグラウンドエンジン</sys:String>

    <!-- Tray Context Menu -->
    <sys:String x:Key="Tray.SyncNow">⚡ 今すぐ同期</sys:String>
    <sys:String x:Key="Tray.RealtimeSync">👁️ リアルタイム監視の有効/無効</sys:String>
    <sys:String x:Key="Tray.Settings">⚙️ 設定...</sys:String>
    <sys:String x:Key="Tray.Logs">📋 ログ表示...</sys:String>
    <sys:String x:Key="Tray.Help">❓ 操作説明...</sys:String>
    <sys:String x:Key="Tray.Exit">🚪 終了</sys:String>
    <sys:String x:Key="Tray.StartedTitle">WoodStreamFileSync 常駐開始</sys:String>
    <sys:String x:Key="Tray.StartedMessage">バックグラウンドでフォルダ同期を監視しています。</sys:String>

    <!-- Status Messages -->
    <sys:String x:Key="Status.Idle">待機中</sys:String>
    <sys:String x:Key="Status.Syncing">同期実行中...</sys:String>
    <sys:String x:Key="Status.Success">同期完了 (最新)</sys:String>
    <sys:String x:Key="Status.Warning">警告 / 一部未完了</sys:String>
    <sys:String x:Key="Status.Error">同期エラー</sys:String>

    <!-- Settings Window -->
    <sys:String x:Key="Settings.Title">WoodStreamFileSync - フォルダ同期設定</sys:String>
    <sys:String x:Key="Settings.FoldersGroup">📁 同期フォルダ設定</sys:String>
    <sys:String x:Key="Settings.SourcePath">同期元 (Source):</sys:String>
    <sys:String x:Key="Settings.DestinationPath">同期先 (Dest):</sys:String>
    <sys:String x:Key="Settings.Browse">参照...</sys:String>
    <sys:String x:Key="Settings.SourceDialogTitle">同期元フォルダを選択してください</sys:String>
    <sys:String x:Key="Settings.DestDialogTitle">同期先フォルダを選択してください</sys:String>

    <sys:String x:Key="Settings.SyncModeGroup">⏱️ 同期モード &amp; トリガー</sys:String>
    <sys:String x:Key="Settings.EnablePeriodic">定期同期を有効にする</sys:String>
    <sys:String x:Key="Settings.IntervalLabel">実行間隔:</sys:String>
    <sys:String x:Key="Settings.IntervalUnit">分ごと</sys:String>
    <sys:String x:Key="Settings.EnableRealtime">リアルタイム変更検知同期 (FileSystemWatcher)</sys:String>
    <sys:String x:Key="Settings.DebounceLabel">変更後待機 (デバウンス):</sys:String>
    <sys:String x:Key="Settings.DebounceUnit">秒</sys:String>
    <sys:String x:Key="Settings.DebounceNote">※ ファイル連続書き込みや大量コピー中の多重起動を防ぐため、最後の更新から指定秒数経過後に自動同期します。</sys:String>

    <sys:String x:Key="Settings.NasGroup">🔐 NAS / ネットワーク共有 認証設定</sys:String>
    <sys:String x:Key="Settings.EnableNas">UNCパス (\\server\share) への事前セッション認証を有効にする</sys:String>
    <sys:String x:Key="Settings.Username">ユーザー名:</sys:String>
    <sys:String x:Key="Settings.Password">パスワード:</sys:String>
    <sys:String x:Key="Settings.TestConnection">接続テスト</sys:String>
    <sys:String x:Key="Settings.TestingConnection">接続テスト中...</sys:String>

    <sys:String x:Key="Settings.RobocopyGroup">⚙️ Robocopy 同期オプション</sys:String>
    <sys:String x:Key="Settings.Mirror">完全ミラーリング (/MIR : ソースにないファイルを同期先から削除)</sys:String>
    <sys:String x:Key="Settings.IncludeEmptySubdirs">空のサブフォルダを含む (/E)</sys:String>
    <sys:String x:Key="Settings.RetryCount">リトライ回数 (/R):</sys:String>
    <sys:String x:Key="Settings.WaitTime">リトライ待機秒数 (/W):</sys:String>
    <sys:String x:Key="Settings.ExcludeFiles">除外ファイル (/XF):</sys:String>
    <sys:String x:Key="Settings.ExcludeDirs">除外フォルダ (/XD):</sys:String>
    <sys:String x:Key="Settings.AdditionalArgs">追加オプション引数:</sys:String>

    <sys:String x:Key="Settings.AppGroup">💻 外観テーマ &amp; アプリケーション動作</sys:String>
    <sys:String x:Key="Settings.ThemeLabel">外観テーマ:</sys:String>
    <sys:String x:Key="Settings.LanguageLabel">表示言語 (Language):</sys:String>
    <sys:String x:Key="Settings.LaunchStartup">Windows 起動時に自動で開始する</sys:String>
    <sys:String x:Key="Settings.MinimizeOnClose">閉じるボタン [X] 押下時にタスクトレイに最小化常駐する</sys:String>
    <sys:String x:Key="Settings.NotifyError">同期エラー時に通知を表示する</sys:String>
    <sys:String x:Key="Settings.NotifySuccess">同期成功時にも毎回通知を表示する</sys:String>

    <sys:String x:Key="Settings.BtnLogs">📋 ログを表示</sys:String>
    <sys:String x:Key="Settings.BtnHelp">❓ 操作説明</sys:String>
    <sys:String x:Key="Settings.BtnSyncNow">⚡ 今すぐ同期</sys:String>
    <sys:String x:Key="Settings.BtnSave">💾 設定を保存</sys:String>
    <sys:String x:Key="Settings.BtnClose">閉じる</sys:String>

    <!-- Logs Window -->
    <sys:String x:Key="Logs.Title">WoodStreamFileSync - 動作ログ</sys:String>
    <sys:String x:Key="Logs.Header">同期ログ &amp; 実行履歴</sys:String>
    <sys:String x:Key="Logs.AutoScroll">新しいログへ自動スクロール</sys:String>
    <sys:String x:Key="Logs.BtnCopy">📋 全てコピー</sys:String>
    <sys:String x:Key="Logs.BtnClear">🗑️ クリア</sys:String>
    <sys:String x:Key="Logs.BtnOpenFolder">📁 ログフォルダを開く</sys:String>
    <sys:String x:Key="Logs.BtnClose">閉じる</sys:String>

    <!-- Help Window -->
    <sys:String x:Key="Help.Title">WoodStreamFileSync - 操作説明 &amp; ご利用ガイド</sys:String>
    <sys:String x:Key="Help.Header">WoodStreamFileSync 操作説明書</sys:String>
    <sys:String x:Key="Help.Subtitle">機能の使い方とおすすめの設定ガイド (v1.0.0.0)</sys:String>

    <sys:String x:Key="Help.Sec1Title">1. 基本操作とタスクトレイ常駐</sys:String>
    <sys:String x:Key="Help.Sec1Desc">本アプリは、Windowsのタスクトレイ（画面右下の通知領域）に常駐してバックグラウンドでフォルダ同期を行います。</sys:String>
    <sys:String x:Key="Help.Sec1P1">• トレイアイコン ダブルクリック: 設定画面を表示します。</sys:String>
    <sys:String x:Key="Help.Sec1P2">• トレイアイコン 右クリック: 「今すぐ同期」「リアルタイム監視の切替」「設定」「ログ表示」「操作説明」「終了」メニューが表示されます。</sys:String>
    <sys:String x:Key="Help.Sec1P3">• 設定画面の [X] 閉じるボタン: アプリを終了せず、タスクトレイに格納（常駐維持）します。</sys:String>
    <sys:String x:Key="Help.Sec1P4">• アプリを完全に終了したい場合は、トレイの右クリックメニューから「🚪 終了」を選択してください。</sys:String>

    <sys:String x:Key="Help.Sec2Title">2. 同期元・同期先フォルダの指定</sys:String>
    <sys:String x:Key="Help.Sec2P1">• 同期元 (Source): バックアップ・同期したい元フォルダを指定します。「参照...」から選択可能です。</sys:String>
    <sys:String x:Key="Help.Sec2P2">• 同期先 (Dest): コピー先のフォルダを指定します。ローカルドライブのほか、NASやファイルサーバーを指定できます。</sys:String>
    <sys:String x:Key="Help.Sec2ExTitle">💡 パスの指定例:</sys:String>
    <sys:String x:Key="Help.Sec2ExLocal">  - ローカルドライブ: C:\Users\YourName\Documents</sys:String>
    <sys:String x:Key="Help.Sec2ExUnc">  - NAS / ファイルサーバー (UNCパス): \\192.168.1.100\share\backup または \\NAS-SERVER\Folder</sys:String>

    <sys:String x:Key="Help.Sec3Title">3. 同期トリガー &amp; デバウンス制御</sys:String>
    <sys:String x:Key="Help.Sec3P1">• 定期同期: 指定した分数（例: 30分）ごとに自動でバックグラウンド同期を実行します。</sys:String>
    <sys:String x:Key="Help.Sec3P2">• リアルタイム変更検知同期: FileSystemWatcher により、ファイルの作成・変更・削除・リネームをリアルタイムに検知して同期します。</sys:String>
    <sys:String x:Key="Help.Sec3P3">変更後待機（デバウンス秒数）:</sys:String>
    <sys:String x:Key="Help.Sec3P4">ファイルの連続保存や大容量ファイルのコピー中に同期が何度も起動するのを防止する機能です。最後のファイル変更から指定秒数（既定: 10秒）の間新たな変更が発生しなくなってから、1回だけ安全に同期を実行します。</sys:String>

    <sys:String x:Key="Help.Sec4Title">4. NAS / ネットワーク共有 認証設定</sys:String>
    <sys:String x:Key="Help.Sec4P1">• UNCパス（\\server\share）にアクセスする際、Windows APIを用いて同期直前にセッションを自動確立します。</sys:String>
    <sys:String x:Key="Help.Sec4P2">• 「接続テスト」ボタン: 入力したユーザー名・パスワードでNASにアクセス可能かを即座に検証できます。</sys:String>
    <sys:String x:Key="Help.Sec4P3">• セキュリティ: パスワードは Windows DPAPI（OS標準の暗号化API）により暗号化して保存されるため、他のユーザーや別PCからは復号できず安全です。</sys:String>

    <sys:String x:Key="Help.Sec5Title">5. Robocopy 詳細オプション</sys:String>
    <sys:String x:Key="Help.Sec5P1">• 完全ミラーリング (/MIR): 同期元で削除されたファイルを、同期先からも自動削除して完全一致させます。</sys:String>
    <sys:String x:Key="Help.Sec5P2">• リトライ設定 (/R /W): ファイル使用中（ロック）時の再試行回数と待機秒数を指定します。（既定: 各1回）</sys:String>
    <sys:String x:Key="Help.Sec5P3">除外ファイル (/XF) &amp; 除外フォルダ (/XD):</sys:String>
    <sys:String x:Key="Help.Sec5P4">一時ファイルやシステムフォルダを除外できます。（例: *.tmp, ~*, thumbs.db, $RECYCLE.BIN, .git など）</sys:String>

    <sys:String x:Key="Help.Sec6Title">6. 外観テーマ &amp; 表示言語の切り替え</sys:String>
    <sys:String x:Key="Help.Sec6P1">• 外観テーマ: 「Windowsのテーマに追従 (既定)」「ライトモード」「ダークモード」から選択できます。Windows OS の設定変更にもリアルタイムに連動します。</sys:String>
    <sys:String x:Key="Help.Sec6P2">• 表示言語: 「Windowsの言語に追従」「日本語」「English」からいつでも即座に切り替え可能です。</sys:String>

    <sys:String x:Key="Help.Sec7Title">7. 動作ログ &amp; トラブルシューティング</sys:String>
    <sys:String x:Key="Help.Sec7P1">• 「📋 ログを表示」ボタン: Robocopy の詳細な転送履歴やエラーメッセージをリアルタイムで確認できます。</sys:String>
    <sys:String x:Key="Help.Sec7P2">• ログの保存: 日別ログファイルが %APPDATA%\WoodStreamFileSync\logs に自動保存されます。「📁 ログフォルダを開く」からアクセスできます。</sys:String>
    <sys:String x:Key="Help.Sec7P3">• 手動即時同期: いつでも「⚡ 今すぐ同期」ボタンを押してその場で最新状態に同期できます。</sys:String>

    <sys:String x:Key="Help.BtnClose">閉じる</sys:String>

</ResourceDictionary>
