<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Palette -->
    <SolidColorBrush x:Key="Theme.Window.Background" Color="#18181B"/>
    <SolidColorBrush x:Key="Theme.Header.Background" Color="#0F172A"/>
    <SolidColorBrush x:Key="Theme.Header.Text" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Theme.Header.SubText" Color="#94A3B8"/>

    <SolidColorBrush x:Key="Theme.Card.Background" Color="#27272A"/>
    <SolidColorBrush x:Key="Theme.Card.Border" Color="#3F3F46"/>
    <Color x:Key="Theme.Card.ShadowColor">#40000000</Color>
    <SolidColorBrush x:Key="Theme.Card.TitleText" Color="#F4F4F5"/>

    <SolidColorBrush x:Key="Theme.Text.Primary" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="Theme.Text.Secondary" Color="#D4D4D8"/>
    <SolidColorBrush x:Key="Theme.Text.Muted" Color="#A1A1AA"/>

    <SolidColorBrush x:Key="Theme.Input.Background" Color="#18181B"/>
    <SolidColorBrush x:Key="Theme.Input.Foreground" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Theme.Input.Border" Color="#52525B"/>

    <SolidColorBrush x:Key="Theme.Button.SecondaryBackground" Color="#3F3F46"/>
    <SolidColorBrush x:Key="Theme.Button.SecondaryForeground" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="Theme.Button.SecondaryBorder" Color="#52525B"/>
    <SolidColorBrush x:Key="Theme.Button.SecondaryHover" Color="#52525B"/>

    <SolidColorBrush x:Key="Theme.Border.Separator" Color="#3F3F46"/>
    <SolidColorBrush x:Key="Theme.BottomBar.Background" Color="#202024"/>

    <SolidColorBrush x:Key="Theme.Log.Background" Color="#090D16"/>
    <SolidColorBrush x:Key="Theme.Log.Foreground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Theme.Log.SelectedBackground" Color="#1E293B"/>

    <SolidColorBrush x:Key="Theme.StatusBadge.Background" Color="#334155"/>
    <SolidColorBrush x:Key="Theme.StatusBadge.Text" Color="#FFFFFF"/>

</ResourceDictionary>
